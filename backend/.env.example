# Database Configuration
DATABASE_URL=mysql+pymysql://appuser:apppassword@mysql:3306/email_signature_db

# Security
SECRET_KEY=your-very-secure-secret-key-min-32-characters-long-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# Environment
ENVIRONMENT=development
